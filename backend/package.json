{
  "name": "growhive-backend",
  "version": "1.0.0",
  "description": "GrowHive backend API - Node.js, Express, MongoDB, Mongoose",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "migrate:create": "migrate-mongo create",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "backup": "node scripts/backupDatabase.js",
    "restore": "node scripts/restoreDatabase.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.5",
    "redis": "^6.2.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.3.1",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "migrate-mongo": "^14.0.7",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
