PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/growhive
# Connection pool/timeout tuning — sensible defaults are baked into db.js,
# only set these to override for a specific deployment's traffic/instance size.
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=2
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000

JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# File uploads — leave blank to disable uploads (returns 503 instead of failing silently)
# Cloudinary handles avatars/covers/gig video (needs resize/quality processing).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 handles documents/resumes/pitch decks (cheap raw storage, no
# transformation needed). R2_PUBLIC_URL is the bucket's public base URL (either
# the r2.dev dev URL or a custom domain you've connected to the bucket) — no
# trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Outbound email — leave blank to log emails to the console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GrowHive <no-reply@growhive.in>

# Where "Contact Us" form submissions land — falls back to EMAIL_FROM/SMTP_USER if blank.
SUPPORT_EMAIL=support@growhive.in

# Google Sign-In — leave blank to disable the "Continue with Google" button
GOOGLE_CLIENT_ID=

# MSG91 — email OTP (all four filled in below = live; leave any blank to
# fall back to SMTP). MSG91_EMAIL_DOMAIN must be a domain verified in your
# MSG91 dashboard (Email > Domains); MSG91_OTP_TEMPLATE_ID is the template's
# unique name (e.g. the pre-approved "global_otp"), not an opaque ID.
# Phone OTP needs its own separate DLT-approved template later.
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_OTP_TEMPLATE_ID=

# Phone verification — which of these is actually used is chosen in
# Admin > Platform Settings (phoneAuthProvider: disabled/firebase), not
# by which of these are filled in. Fill in whichever provider you plan to pick.

# Firebase phone auth — service account credentials (Project Settings > Service
# Accounts > Generate new private key). Keep the \n escapes in the private key
# literal — they're unescaped in code, real newlines in the .env will break it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay — leave blank to disable Razorpay checkout (returns 503)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX Payouts — automates freelancer withdrawals. Leave blank and admins
# fall back to marking withdrawals paid manually after sending money themselves.
# Uses the same RAZORPAY_KEY_ID/SECRET above, plus your RazorpayX current account number.
RAZORPAYX_ACCOUNT_NUMBER=

# Stripe — leave blank to disable Stripe checkout (returns 503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error tracking — leave blank to disable Sentry (server logs to the console only)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Console log verbosity: error/warn/info/http/debug (defaults to debug in dev, info in production)
LOG_LEVEL=

# Redis — leave blank to use an in-process cache/counter store instead (fine
# for a single instance; doesn't share state across multiple instances).
REDIS_URL=
