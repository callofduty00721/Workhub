# Backend's full URL (e.g. https://your-backend.up.railway.app) — only
# needed when frontend and backend are on different domains (e.g. Vercel +
# Railway). Leave blank for local dev / same-origin deployments (Vite's dev
# proxy or nginx already forward relative /api and /socket.io requests).
VITE_API_URL=

# Google Sign-In — leave blank to hide the "Continue with Google" button
VITE_GOOGLE_CLIENT_ID=

# Firebase phone auth — only needed if Admin > Platform Settings has
# phoneAuthProvider set to "firebase". Values come from Firebase Console >
# Project Settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
